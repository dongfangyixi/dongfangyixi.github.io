---
import Base from '../layouts/Base.astro';
import { videos, embedUrl } from '../data/videos';
import { t } from '../i18n/ui';

const locale = (Astro.currentLocale ?? 'en') as 'en' | 'zh';
---

<Base title={`${t(locale, 'videos.title')} · ${t(locale, 'site.brand')}`} description={t(locale, 'videos.description')}>
  <section class="hero">
    <span class="eyebrow"><span class="cjk">影像</span>Video</span>
    <h1>{t(locale, 'videos.title')}</h1>
    <p class="lede">{t(locale, 'videos.description')}</p>
  </section>
  <section>
    <div class="video-grid">
      {videos.map((v) => (
        <div class="video-card">
          <div class="video-embed">
            <iframe src={embedUrl(v)} title={v.title} loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
          <div class="body">
            <h3>{v.title}</h3>
            {v.date && <p class="meta">{v.date} · {v.platform}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
