---
import Base from '../layouts/Base.astro';
import { videos, embedUrl } from '../data/videos';
---
<Base title="Videos · dongfangyixi" description="Videos by dongfangyixi on YouTube and Bilibili.">
  <section class="hero">
    <h1>Videos</h1>
    <p class="lede">My videos from YouTube and Bilibili. Edit <code>src/data/videos.ts</code> to add more.</p>
  </section>
  <section>
    <div class="video-grid">
      {videos.map((v) => (
        <div class="video-card">
          <div class="video-embed">
            <iframe src={embedUrl(v)} title={v.title} loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
          <div class="body">
            <h3>{v.title}</h3>
            {v.date && <p class="meta">{v.date} · {v.platform}</p>}
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>
