---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const items = await getCollection('news');
  return items.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
const base = import.meta.env.BASE_URL;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title={`${item.data.title} · 东方一㬢`} description={item.data.title}>
  <article class="hero">
    <span class="eyebrow"><span class="cjk">近况</span>Now</span>
    <h1>{item.data.title}</h1>
    <p class="meta">{fmt(item.data.date)}</p>
  </article>
  <div class="prose">
    <Content />
  </div>
  {item.data.link && (
    <p class="source-link">
      <a href={item.data.link} target="_blank" rel="noopener">Source ↗</a>
    </p>
  )}
  <a class="back-link" href={`${base}news`}>← Back to all news</a>
</Base>
