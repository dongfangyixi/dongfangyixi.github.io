---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title="News · 东方一㬢" description="What 东方一㬢 is currently reading and exploring.">
  <section class="hero">
    <span class="eyebrow"><span class="cjk">近况</span>Now</span>
    <h1>What I'm focusing on</h1>
    <p class="lede">Short notes on what I'm reading and exploring lately.</p>
  </section>
  <section>
    {news.map((item) => (
      <a class="card" href={`${base}news/${item.slug}`}>
        <h3>{item.data.title}</h3>
        <p class="meta">{fmt(item.data.date)}</p>
      </a>
    ))}
    {news.length === 0 && <p class="meta">No updates yet — add markdown files in <code>src/content/news/</code>.</p>}
  </section>
</Base>
