---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const base = import.meta.env.BASE_URL;
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Base title="News · dongfangyixi" description="What dongfangyixi is currently focusing on.">
  <section class="hero">
    <h1>What I'm focusing on</h1>
    <p class="lede">Short updates on current projects, interests, and milestones.</p>
  </section>
  <section>
    {news.map(async (item) => {
      const { Content } = await item.render();
      return (
        <div class="card" style="cursor:default">
          <h3>{item.data.link ? <a href={item.data.link} target="_blank" rel="noopener">{item.data.title}</a> : item.data.title}</h3>
          <p class="meta">{fmt(item.data.date)}</p>
          <div class="prose"><Content /></div>
        </div>
      );
    })}
    {news.length === 0 && <p class="meta">No updates yet — add markdown files in <code>src/content/news/</code>.</p>}
  </section>
</Base>
