---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="About" description="About this site.">
  <section class="hero">
    <span class="eyebrow"><span class="cjk">关于</span>About</span>
    <h1>About</h1>
    <p class="lede">This is where I collect my writing, updates, and videos.</p>
  </section>
  <section class="prose">
    <p>
      Welcome. This site brings together my <a href={`${base}blog`}>blog</a>, the
      <a href={`${base}news`}> latest news I'm following</a>, and my
      <a href={`${base}videos`}> videos</a>.
    </p>
  </section>
</Base>
